/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; frame-src https://www.youtube-nocookie.com https://www.youtube.com; font-src 'self'; connect-src 'self' https://api.web3forms.com https://chalktalkfb.pages.dev https://ll.thespacedevs.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
